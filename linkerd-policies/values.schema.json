{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "projects"],
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destinations", "projects"],
      "properties": {
        "destinations": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/dnsLabel"},
          "additionalProperties": {"$ref": "#/definitions/destination"}
        },
        "projects": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/dnsLabel"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespaces", "destinations"],
            "properties": {
              "namespaces": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/definitions/dnsLabel"}
              },
              "destinations": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/definitions/dnsLabel"}
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "object",
      "propertyNames": {"$ref": "#/definitions/dnsLabel"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grants"],
        "properties": {
          "grants": {
            "type": "object",
            "propertyNames": {"$ref": "#/definitions/dnsLabel"},
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["serviceAccounts"],
              "properties": {
                "serviceAccounts": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["namespace", "name"],
                    "properties": {
                      "namespace": {"$ref": "#/definitions/dnsLabel"},
                      "name": {"$ref": "#/definitions/dnsSubdomain"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "labelKey": {
      "type": "string",
      "maxLength": 317,
      "anyOf": [
        {"pattern": "^[^/]+$"},
        {"pattern": "^[^/]{1,253}/[^/]+$"}
      ],
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*\\/)?[A-Za-z0-9]([-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "port", "podSelector"],
      "properties": {
        "namespace": {"$ref": "#/definitions/dnsLabel"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "protocol": {
          "type": "string",
          "enum": ["unknown", "HTTP/1", "HTTP/2", "gRPC", "opaque", "TLS"],
          "default": "unknown"
        },
        "podSelector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matchLabels"],
          "properties": {
            "matchLabels": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"$ref": "#/definitions/labelKey"},
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[A-Za-z0-9]([-_.A-Za-z0-9]*[A-Za-z0-9])?$"
              }
            }
          }
        }
      }
    }
  }
}
